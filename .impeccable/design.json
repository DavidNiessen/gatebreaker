      "description": "Popup action while checking or unavailable.",
      "html": "<button class=\"ds-primary\" type=\"button\" disabled>Checking download…</button>",
      "css": ".ds-primary{font:600 14px/1.4 system-ui,sans-serif;width:100%;min-height:46px;display:flex;align-items:center;justify-content:center;padding:12px 16px;border-radius:7px;cursor:pointer;color:#fff;background:var(--green,#365339);border:1px solid var(--green,#365339)}.ds-primary:hover:enabled{background:var(--green-hover,#29412c)}.ds-primary:disabled{color:#666e5f;background:#e2e5d9;border-color:#d2d5c8;cursor:default}.ds-primary:focus-visible{outline:3px solid var(--focus,#a65313);outline-offset:3px}@media(prefers-reduced-motion:no-preference){.ds-primary{transition:background .15s ease-out}}@media(prefers-color-scheme:dark){.ds-primary{background:var(--green,#c2dab1);border-color:var(--green,#c2dab1);color:#1e321e}.ds-primary:hover:enabled{background:var(--green-hover,#d0e9bf)}.ds-primary:disabled{color:#b2bba7;background:#35422f;border-color:#485440}.ds-primary:focus-visible{outline-color:var(--focus,#ebaa6c)}}"
    },
    {
      "name": "Download link",
      "kind": "custom",
      "refersTo": "download",
      "description": "Filled primary result control above the secondary retry button; preview has no live download destination.",
      "html": "<a class=\"ds-download\" href=\"#download-preview\">Open download</a>",
      "css": ".ds-download{font:600 14px/1.4 system-ui,sans-serif;width:100%;min-height:46px;display:flex;align-items:center;justify-content:center;padding:12px 16px;border-radius:7px;cursor:pointer;color:#fff;background:var(--green,#365339);border:1px solid var(--green,#365339)}.ds-download:hover{background:var(--green-hover,#29412c)}.ds-download:disabled{color:#666e5f;background:#e2e5d9;border-color:#d2d5c8;cursor:default}.ds-download:focus-visible{outline:3px solid var(--focus,#a65313);outline-offset:3px}@media(prefers-reduced-motion:no-preference){.ds-download{transition:background .15s ease-out}}@media(prefers-color-scheme:dark){.ds-download{background:var(--green,#c2dab1);border-color:var(--green,#c2dab1);color:#1e321e}.ds-download:hover{background:var(--green-hover,#d0e9bf)}.ds-download:disabled{color:#b2bba7;background:#35422f;border-color:#485440}.ds-download:focus-visible{outline-color:var(--focus,#ebaa6c)}}.ds-download{margin-bottom:10px;text-decoration:none}"
    },
