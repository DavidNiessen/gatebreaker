    {
      "name": "Injected page panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Fixed-light assistant after the original control. Preserves source panel spacing and native action states.",
      "html": "<section class=\"ds-panel\" aria-label=\"Gatebreaker download assistant\"><h2>Gatebreaker</h2><p role=\"status\" aria-live=\"polite\">A download link is ready. Open it to continue.</p><a href=\"#download-preview\">Open download</a><button type=\"button\" data-secondary=\"true\">Try again</button></section>",
      "css": ".ds-panel{padding:18px;background:#f5f4ed;border:1px solid #d2d5c8;border-radius:12px;color:#242820;color-scheme:light;font:14px/1.5 system-ui,-apple-system,'Segoe UI',sans-serif}.ds-panel h2{font-size:16px;line-height:1.3;margin:0 0 6px;font-weight:700;color:#242820}.ds-panel p{margin:0 0 14px;font-size:13px;color:#50564a;overflow-wrap:anywhere}.ds-panel button{display:inline-flex;justify-content:center;align-items:center;min-height:44px;padding:10px 16px;border-radius:7px;font:600 14px/1.3 system-ui,sans-serif;cursor:pointer;color:#fff;background:#365339;border:1px solid #365339;width:100%}.ds-panel button:hover{background:#29412c}.ds-panel button:disabled{opacity:.65;cursor:wait}.ds-panel button:focus-visible{outline:3px solid #a65313;outline-offset:3px}@media(prefers-reduced-motion:no-preference){.ds-panel button{transition:background .15s ease-out}}.ds-panel a{display:inline-flex;justify-content:center;align-items:center;min-height:44px;padding:10px 16px;border-radius:7px;font:600 14px/1.3 system-ui,sans-serif;cursor:pointer;margin-bottom:10px;color:#fff;background:#365339;border:1px solid #365339;text-decoration:none;width:100%}.ds-panel a:hover{background:#29412c}.ds-panel a:focus-visible{outline:3px solid #a65313;outline-offset:3px}.ds-panel button[data-secondary=\"true\"]{color:#365339;background:transparent;border-color:#a6b79e}.ds-panel button[data-secondary=\"true\"]:hover{background:#e3ebdc}"
    },
    {
