{
  "name": "gatebreaker",
  "version": "0.12.1",
  "private": true,
  "description": "A reusable TypeScript download-gate engine and Chrome/Firefox extension.",
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist/core",
    "README.md",
    "LICENSE",
    "PRIVACY.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavidNiessen/gatebreaker.git"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:extension && npm run build:cli",
    "build:core": "node scripts/build-core.mjs",
    "build:extension": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run check:boundaries && npm run typecheck && npm test && npm run build && npm run test:core:node && npm run test:cli:package && npm run lint:firefox",
    "check:boundaries": "node scripts/check-core-boundary.mjs",
    "test:core:node": "node scripts/test-core-node.mjs",
    "lint:firefox": "addons-linter dist/firefox --warnings-as-errors",
    "test:browser": "node scripts/test-browser.mjs chrome && node scripts/test-browser.mjs firefox",
    "test:browser:chrome": "node scripts/test-browser.mjs chrome",
    "check:live": "node scripts/check-live.mjs",
    "check:hypeddit": "node scripts/check-hypeddit-live.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "test:cli:package": "node scripts/test-cli-package.mjs",
    "test:cli:browser": "node scripts/test-cli-browser.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.18.0",
    "addons-linter": "^10.15.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "jsdom": "^26.1.0",
    "playwright": "^1.56.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "packages/cli"
  ]
}
